{
  "name": "egonux",
  "version": "3.4.0",
  "description": "EGONUX - Empowering the Next Generation of Digital Wealth",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:rules": "firebase emulators:exec --project egonux-sandbox --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:smoke": "export NODE_ENV=development; export EGONUX_AUTH_REQUIRED=false; node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:smoke",
    "check:backend": "npm run lint && npm run typecheck && npm run test:rules",
    "test:v33": "node scripts/test-identity-ledger.mjs",
    "test:v33-full": "npm run typecheck && npm run build && npm run test:v33-strict && npm run test:invitation && npm run test:redemption && npm run test:ledger && npm run test:incident && npm run test:identity && npm run test:consent-day5 && npm run test:ledger-day6 && npm run test:security-day7 && npm run test:recovery-day8 && npm run test:perf-day9 && npm run test:compliance-day10 && npm run test:ops-day11 && npm run test:audit-day12 && npm run test:week2-identity",
    "test:v33-strict": "node scripts/test-identity-ledger.mjs",
    "test:invitation": "node scripts/test-invitation-dispatch.mjs",
    "test:redemption": "node scripts/test-redemption-controls.mjs",
    "test:ledger": "node scripts/test-ledger-concurrency.mjs",
    "test:incident": "node scripts/test-incident-response.mjs",
    "test:identity": "node scripts/test-identity-security.mjs",
    "test:consent-day5": "node scripts/test-day5-consent-lifecycle.mjs",
    "test:ledger-day6": "node scripts/test-day6-ledger-invariants.mjs",
    "test:security-day7": "node scripts/test-day7-api-security.mjs",
    "test:recovery-day8": "node scripts/test-day8-recovery-resilience.mjs",
    "test:perf-day9": "node scripts/test-day9-performance-stability.mjs",
    "test:compliance-day10": "node scripts/test-day10-compliance-privacy.mjs",
    "test:ops-day11": "node scripts/test-day11-ops-readiness.mjs",
    "test:audit-day12": "node scripts/test-day12-e2e-audit.mjs",
    "test:week2-identity": "node scripts/test-week2-identity-privacy.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.102",
    "firebase": "^12.19.0",
    "firebase-admin": "13.6.0",
    "google-auth-library": "^9.15.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "csv-parse": "7.0.2",
    "uuid": ">=11.1.1",
    "@opentelemetry/core": ">=2.8.0",
    "qs": ">=6.16.0"
  },
  "engines": {
    "node": "24.x"
  }
}