{
  "name": "egonux",
  "version": "3.0.1",
  "description": "EGONUX - Empowering the Next Generation of Digital Wealth",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:rules": "firebase emulators:exec --project egonux-sandbox --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:smoke",
    "check:backend": "npm run lint && npm run typecheck && npm run test:rules"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  },
  "engines": {
    "node": "24.x"
  }
}
