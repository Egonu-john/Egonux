# Public web configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=false

# Firebase client configuration (supply through the deployment environment)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Cloud server configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=africa-south1
VERTEX_AI_LOCATION=us-central1

# Authentication session configuration
# Use Application Default Credentials in approved Google Cloud environments.
# Local development should use Firebase emulators rather than downloaded keys.
EGONUX_SESSION_COOKIE_NAME=egonux_session
EGONUX_SESSION_TTL_DAYS=5
EGONUX_ALLOWED_ORIGINS=http://localhost:3000
EGONUX_AUTH_REQUIRED=false
# Comma-separated, exact Firebase emails granted the founder role server-side.
EGONUX_FOUNDER_EMAILS=
EGONUX_FOUNDER_DISPLAY_NAME=
EGONUX_FOUNDER_TITLE=Founder & Chief Executive Officer
ANOSA_AI_MODEL=anthropic/claude-sonnet-5
ANOSA_STEP_UP_WINDOW_MINUTES=15
# Phase 3 remains simulation-only. Do not add an execute mode here.
ANOSA_EXECUTION_MODE=simulate
# Enable only after GCP Workload Identity Federation and Firestore IAM are verified.
ANOSA_FIRESTORE_LEDGER_ENABLED=false
# AI Gateway uses Vercel OIDC in production. For local development only:
# AI_GATEWAY_API_KEY=

# Never place service-account JSON, API secrets, payment credentials or private keys here.
