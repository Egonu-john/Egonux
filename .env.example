# Public web configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=false

# Firebase client configuration (supply through the deployment environment)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Cloud server configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=africa-south1
VERTEX_AI_LOCATION=us-central1

# Never place service-account JSON, API secrets, payment credentials or private keys here.
